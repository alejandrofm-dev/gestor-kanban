<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Tarea</title>
</head>

<body>
    <h1>Editar Tarea</h1>
    <form action="index.php?c=task&updateTask" method="post">
        <input type="hidden" name="id" value="<?= $task->getId() ?>">
        <label for="title">Título</label><br>
        <input type="text" name="title" id="title" value="<?= $task->getTitle() ?>"><br>
