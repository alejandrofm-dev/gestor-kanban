    <?php
    if (isset($_GET['error'])) {
        if ($_GET['error'] == 'camposvacios') {
            echo "<p style='color: red;'>Rellena todos los campos</p>";
        } else if ($_GET['error'] == 'erroralactualizar') {
            echo "<p style='color: red;'>Error al actualizar la tarea</p>";
        }
    }
    ?>
